# Google Search Console – vrijednost "content" iz meta taga za verifikaciju (opcionalno)
GOOGLE_SITE_VERIFICATION=

# SMTP za kontakt formu (kopirati u .env.local i popuniti)
SMTP_HOST=mail.synthesispharma.ba
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=web@synthesispharma.ba
SMTP_PASS=

# Kome stižu poruke (podrazumijevano info@synthesispharma.ba)
CONTACT_TO=info@synthesispharma.ba
# Pošiljalac (mora biti dozvoljen na SMTP serveru)
CONTACT_FROM="Synthesis Pharma web <web@synthesispharma.ba>"
