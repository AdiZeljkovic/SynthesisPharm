<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS konfiguracija za statični Synthesis Pharma sajt (Windows Plesk).
  Provjereno na serveru: URL Rewrite postoji; sekcije serverRuntime i httpCompression su zaključane
  (serverRuntime u web.config-u = greška 500 za cijeli sajt – ne dodavati).
  Stare .html adrese: 301 preko rewriteMap-a (upisuje ga scripts/legacy-redirects.mjs) + rezervne stranice.
-->
<configuration>
  <!-- Iz Pleskovog originalnog web.config-a na serveru -->
  <system.web>
    <compilation tempDirectory="C:\Inetpub\vhosts\synthesispharma.ba\tmp" />
  </system.web>

  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <!-- Spisak fajlova koji koristi automatska objava (GitHub Actions → FTP) -->
          <add segment=".ftp-deploy-sync-state.json" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".txt" />
      <mimeMap fileExtension=".txt" mimeType="text/plain; charset=utf-8" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <!-- Unaprijed kompresovane verzije (scripts/precompress.mjs); pravi Content-Type postavlja rewrite ispod -->
      <remove fileExtension=".br" />
      <mimeMap fileExtension=".br" mimeType="application/octet-stream" />
      <!-- HTML i podaci stranica: kratko keširanje, da izmjene iz admina budu brzo vidljive -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="0.00:05:00" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>

    <!--
      Brotli: IIS na ovom hostingu kompresuje tek nakon 2 zahtjeva u 10 s (postavka zaključana),
      pa poslužujemo unaprijed kompresovane .br fajlove (scripts/precompress.mjs) preko URL Rewrite.
    -->
    <rewrite>
      <rewriteMaps>
        <rewriteMap name="StareAdrese">
          <!--STARE-ADRESE-->
        </rewriteMap>
      </rewriteMaps>
      <rules>
        <rule name="Stare adrese (301)" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{StareAdrese:{URL}}" pattern="(.+)" />
          </conditions>
          <action type="Redirect" url="{C:1}" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="Brotli fajl" stopProcessing="true">
          <match url="^(.*\.(?:html|js|css|txt|xml|svg|json|webmanifest))$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="\bbr\b" />
            <add input="{REQUEST_FILENAME}.br" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.br" />
        </rule>
        <rule name="Brotli folder" stopProcessing="true">
          <match url="^(.*/)?$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="\bbr\b" />
            <add input="{REQUEST_FILENAME}index.html.br" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}index.html.br" />
        </rule>
      </rules>
      <outboundRules>
        <preConditions>
          <preCondition name="IsBr"><add input="{REQUEST_FILENAME}" pattern="\.br$" /></preCondition>
          <preCondition name="IsHtmlBr"><add input="{REQUEST_FILENAME}" pattern="\.html\.br$" /></preCondition>
          <preCondition name="IsJsBr"><add input="{REQUEST_FILENAME}" pattern="\.js\.br$" /></preCondition>
          <preCondition name="IsCssBr"><add input="{REQUEST_FILENAME}" pattern="\.css\.br$" /></preCondition>
          <preCondition name="IsTxtBr"><add input="{REQUEST_FILENAME}" pattern="\.txt\.br$" /></preCondition>
          <preCondition name="IsXmlBr"><add input="{REQUEST_FILENAME}" pattern="\.xml\.br$" /></preCondition>
          <preCondition name="IsSvgBr"><add input="{REQUEST_FILENAME}" pattern="\.svg\.br$" /></preCondition>
          <preCondition name="IsJsonBr"><add input="{REQUEST_FILENAME}" pattern="\.json\.br$" /></preCondition>
          <preCondition name="IsManifestBr"><add input="{REQUEST_FILENAME}" pattern="\.webmanifest\.br$" /></preCondition>
        </preConditions>
        <rule name="br encoding" preCondition="IsBr"><match serverVariable="RESPONSE_Content_Encoding" pattern=".*" /><action type="Rewrite" value="br" /></rule>
        <rule name="br vary" preCondition="IsBr"><match serverVariable="RESPONSE_Vary" pattern=".*" /><action type="Rewrite" value="Accept-Encoding" /></rule>
        <rule name="br html" preCondition="IsHtmlBr"><match serverVariable="RESPONSE_Content_Type" pattern=".*" /><action type="Rewrite" value="text/html; charset=utf-8" /></rule>
        <rule name="br js" preCondition="IsJsBr"><match serverVariable="RESPONSE_Content_Type" pattern=".*" /><action type="Rewrite" value="application/javascript; charset=utf-8" /></rule>
        <rule name="br css" preCondition="IsCssBr"><match serverVariable="RESPONSE_Content_Type" pattern=".*" /><action type="Rewrite" value="text/css; charset=utf-8" /></rule>
        <rule name="br txt" preCondition="IsTxtBr"><match serverVariable="RESPONSE_Content_Type" pattern=".*" /><action type="Rewrite" value="text/plain; charset=utf-8" /></rule>
        <rule name="br xml" preCondition="IsXmlBr"><match serverVariable="RESPONSE_Content_Type" pattern=".*" /><action type="Rewrite" value="application/xml; charset=utf-8" /></rule>
        <rule name="br svg" preCondition="IsSvgBr"><match serverVariable="RESPONSE_Content_Type" pattern=".*" /><action type="Rewrite" value="image/svg+xml" /></rule>
        <rule name="br json" preCondition="IsJsonBr"><match serverVariable="RESPONSE_Content_Type" pattern=".*" /><action type="Rewrite" value="application/json; charset=utf-8" /></rule>
        <rule name="br manifest" preCondition="IsManifestBr"><match serverVariable="RESPONSE_Content_Type" pattern=".*" /><action type="Rewrite" value="application/manifest+json" /></rule>
      </outboundRules>
    </rewrite>

    <httpErrors errorMode="Custom" existingResponse="Auto">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="404.html" responseMode="File" />
    </httpErrors>
  </system.webServer>

  <!-- JS/CSS sa hash imenima: godinu dana -->
  <location path="_next/static">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Slike i video: 30 dana (promijenjene slike dobijaju nova imena) -->
  <location path="_img">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="images">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="video">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="icons">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- PHP API (kontakt forma): bez keširanja, a JSON odgovori sa greškom (422/429/500) prolaze netaknuti -->
  <location path="api">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
      <httpErrors existingResponse="PassThrough" />
    </system.webServer>
  </location>
</configuration>
