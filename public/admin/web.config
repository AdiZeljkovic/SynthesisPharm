<?xml version="1.0" encoding="utf-8"?>
<!-- Admin panel: bez keširanja, bez indeksiranja, _data (lozinka, token, sesije) nedostupan preko weba -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="_data" />
          <add segment=".user.ini" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <add name="X-Robots-Tag" value="noindex, nofollow" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
